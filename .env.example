APP_NAME=
LOGGER='dev'
RUN_ENV='dev'

# STAGING AZURE DB
PG_PORT=5432
# PG_USER=
# PG_PW=
# PG_DB=
# PG_HOST=
# PG_SSL_PATH=
# PG_SSLMODE=

# STAGING DOCKER DB
# PGHOST=
PGHOST=pg_db
# That ^ pattern is: container → host (published port 5432) → Postgres container.
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=staging
PG_SSLMODE=require
PG_SSL_PATH=/opt/resources/ssl/pg_ssl.crt

# DATA STORE PATHS
DATA_STORE_DEV=/opt/resources/acqu_files
DATA_STORE_STAGING=/opt/resources/acqu_files/staging

## PATHS
TUNNEL_RESET_APP=./read/sh/tunnel_reset.sh
DEV_HHM_FILES=/home/matt-teixeira/hep3/hhm_data_acquisition/files
STAGING_HHM_FILES=/home/staging/hhm_data_acquisition/files
PROD_HHM_FILES=/home/prod/hhm_data_acquisition/files

# REDIS
REDIS_HOST=redis_dev-0-4
REDIS_PORT=6379

# prod
VNS3_IP=
VNS3_PW=


# DOCKER RUN USER (gosu entrypoint)
RUN_USER=svc

